---
import CreateBandForm from "@/components/bands/CreateBandForm";
import { Card } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { listMyBands } from "@/lib/services/bands";
import { createClient } from "@/lib/supabase";

const error = Astro.url.searchParams.get("error");
const supabase = createClient(Astro.request.headers, Astro.cookies);

let bands: Awaited<ReturnType<typeof listMyBands>> = [];
if (supabase) {
  bands = await listMyBands(supabase);
}

const formatCreatedAt = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
  second: "2-digit",
});
---

<Layout title="Dashboard">
  <div class="dark bg-background text-foreground min-h-screen">
    <div class="mx-auto flex w-full max-w-lg flex-col gap-6 p-4">
      <h1 class="text-2xl font-semibold">Bands</h1>
      {bands.length === 0 ? (
        <p class="text-muted-foreground">You have no bands yet</p>
      ) : (
        <ul class="flex flex-col gap-3">
          {bands.map((band) => (
            <li>
              <a href={`/bands/${band.id}`} class="block">
                <Card className="px-6 transition-colors hover:bg-accent">
                  <div class="flex flex-col gap-1">
                    <p class="font-medium">{band.name}</p>
                    {band.role === "owner" && <p class="text-sm text-muted-foreground">Owner</p>}
                    <p class="text-sm text-muted-foreground">
                      <time datetime={band.createdAt}>{formatCreatedAt.format(new Date(band.createdAt))}</time>
                    </p>
                    <p class="text-xs text-muted-foreground">{band.id.slice(0, 8)}</p>
                  </div>
                </Card>
              </a>
            </li>
          ))}
        </ul>
      )}
      <Card className="px-6">
        <div class="flex flex-col gap-6">
          <h2 class="text-lg font-semibold">Create a band</h2>
          <CreateBandForm serverError={error} client:load />
        </div>
      </Card>
    </div>
  </div>
</Layout>
